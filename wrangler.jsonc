{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "septicbeacon",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "SUPABASE_URL": "https://dkpsiwytmvgylqhbntmg.supabase.co",
    "GA4_MEASUREMENT_ID": "",
    "GSC_VERIFICATION": ""
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "septicbeacon-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
